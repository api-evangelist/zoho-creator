            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_owner_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "app_link_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://accounts.zoho.com/oauth/v2/auth?access_type=offline",
              "accessTokenUrl": "https://accounts.zoho.com/oauth/v2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This API fetches the information about the sections and underlying components—forms, reports, and pages—defined for a Zoho Creator application's web form factor."
